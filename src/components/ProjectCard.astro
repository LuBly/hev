---
import type { CollectionEntry } from "astro:content";
import { withBase, type Lang } from "../config/site";
import { getCopy } from "../i18n/copy";
import AssetSlot from "./AssetSlot.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  lang: Lang;
  index: number;
}

const { entry, lang, index } = Astro.props;
const t = getCopy(lang);
const data = entry.data;
---

<article class:list={["project-card", { "project-card--reverse": index % 2 === 1 }]} data-reveal>
  <AssetSlot src={data.image} alt={data.imageAlt} label={data.title} spec={data.assetSpec} class="project-card__media" />
  <div class="project-card__content">
    <span class="project-card__number">{String(index + 1).padStart(2, "0")}</span>
    <p class="project-type">{data.type}</p>
    <h2>{data.title}</h2>
    <h3>{data.tagline}</h3>
    <p>{data.excerpt}</p>
    <a class="text-link" href={withBase(`/${lang}/projects/${data.slug}/`)}>{t.common.viewProject}<span aria-hidden="true">↗</span></a>
  </div>
</article>
