---
import type { CollectionEntry } from "astro:content";
import { withBase, type Lang } from "../config/site";
import { getCopy } from "../i18n/copy";
import AssetSlot from "./AssetSlot.astro";

interface Props {
  entry: CollectionEntry<"news">;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = getCopy(lang);
const data = entry.data;
---

<article class="news-card" data-category={data.category} data-reveal>
  <a href={withBase(`/${lang}/news/${data.slug}/`)} tabindex="-1" aria-hidden="true">
    <AssetSlot src={data.image} alt={data.imageAlt} label={data.categoryLabel} spec={data.assetSpec} class="news-card__media" />
  </a>
  <div class="news-card__body">
    <span>{data.categoryLabel}</span>
    <h2><a href={withBase(`/${lang}/news/${data.slug}/`)}>{data.title}</a></h2>
    <p>{data.excerpt}</p>
    <a class="text-link" href={withBase(`/${lang}/news/${data.slug}/`)}>{t.common.readMore}<span aria-hidden="true">↗</span></a>
  </div>
</article>
