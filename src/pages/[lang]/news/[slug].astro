---
import { getCollection, render } from "astro:content";
import AssetSlot from "../../../components/AssetSlot.astro";
import NewsCard from "../../../components/NewsCard.astro";
import { withBase, type Lang } from "../../../config/site";
import { getCopy } from "../../../i18n/copy";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getNews } from "../../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("news");
  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const lang = entry.data.lang as Lang;
const t = getCopy(lang);
const data = entry.data;
const { Content } = await render(entry);
const related = (await getNews(lang)).filter((item) => item.data.slug !== data.slug).slice(0, 3);
---

<BaseLayout lang={lang} title={`${data.title} | HEV`} description={data.excerpt} image={data.image}>
  <article class="news-detail">
    <header class="site-shell news-detail__header" data-reveal>
      <a class="text-link detail-back" href={withBase(`/${lang}/news/`)}><span aria-hidden="true">←</span>{t.news.back}</a>
      <p class="section-label">{data.categoryLabel}</p>
      <h1>{data.title}</h1>
      <p>{data.excerpt}</p>
    </header>
    <div class="site-shell">
      <AssetSlot src={data.image} alt={data.imageAlt} label={data.categoryLabel} spec={data.assetSpec} class="news-detail__media" eager />
    </div>
    <div class="site-shell prose prose--article" data-reveal>
      <Content />
    </div>
  </article>
  <section class="section-block site-shell related-news" aria-labelledby="related-title">
    <div class="section-heading">
      <h2 id="related-title">{t.home.newsTitle}</h2>
      <a class="text-link" href={withBase(`/${lang}/news/`)}>{t.common.viewNews}<span aria-hidden="true">↗</span></a>
    </div>
    <div class="news-grid">
      {related.map((item) => <NewsCard entry={item} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
