---
import NewsCard from "../../../components/NewsCard.astro";
import PageIntro from "../../../components/PageIntro.astro";
import { languages, type Lang } from "../../../config/site";
import { getCopy } from "../../../i18n/copy";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getNews } from "../../../lib/content";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getCopy(lang);
const news = await getNews(lang);
const filters = [
  { key: "all", label: t.news.all },
  { key: "hev", label: t.news.categories.hev },
  { key: "bandclub", label: t.news.categories.bandclub },
  { key: "clicktoon", label: t.news.categories.clicktoon },
];
---

<BaseLayout lang={lang} title={`${t.nav.news} | HEV`} description={t.news.lead}>
  <PageIntro kicker="NEWS" title={t.news.title} lead={t.news.lead} />
  <section class="site-shell news-page" aria-label={t.nav.news}>
    <div class="news-filters" role="group" aria-label={lang === "ko" ? "소식 분류" : "News category"}>
      {filters.map((filter, index) => (
        <button type="button" data-filter={filter.key} aria-pressed={index === 0 ? "true" : "false"}>{filter.label}</button>
      ))}
    </div>
    <div class="news-grid" data-news-grid>
      {news.map((entry) => <NewsCard entry={entry} lang={lang} />)}
    </div>
    <p class="news-empty" data-news-empty hidden>{t.news.empty}</p>
  </section>
  <script is:inline>
    const buttons = document.querySelectorAll("[data-filter]");
    const cards = document.querySelectorAll("[data-news-grid] .news-card");
    const empty = document.querySelector("[data-news-empty]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter");
        let visibleCount = 0;
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        cards.forEach((card) => {
          const visible = filter === "all" || card.getAttribute("data-category") === filter;
          card.toggleAttribute("hidden", !visible);
          if (visible) visibleCount += 1;
        });
        if (empty instanceof HTMLElement) empty.hidden = visibleCount !== 0;
      });
    });
  </script>
</BaseLayout>
