---
import AssetSlot from "../../components/AssetSlot.astro";
import BusinessCta from "../../components/BusinessCta.astro";
import NewsCard from "../../components/NewsCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { languages, siteConfig, withBase, type Lang } from "../../config/site";
import { getCopy } from "../../i18n/copy";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNews, getProjects } from "../../lib/content";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getCopy(lang);
const projects = await getProjects(lang);
const news = (await getNews(lang)).slice(0, 3);
---

<BaseLayout lang={lang} title={`HEV | ${t.home.title}`} description={t.home.summary} image={siteConfig.images.homeHero}>
  <section class="home-hero">
    <AssetSlot
      src={siteConfig.images.homeHero}
      alt={lang === "ko" ? "HEV 스튜디오 대표 이미지" : "HEV studio hero image"}
      label="HEV STUDIO"
      spec="public/images/hero/hev-studio.webp · 2400x1350 · 16:9"
      class="home-hero__media"
      eager
    />
    <div class="site-shell home-hero__content" data-reveal>
      <p class="home-hero__brand">HEV</p>
      <h1>{t.home.title}</h1>
      <p>{t.home.summary}</p>
      <div class="button-row">
        <a class="button button--light" href={withBase(`/${lang}/projects/`)}>{t.common.viewProjects}</a>
        <a class="button button--outline-light" href={withBase(`/${lang}/contact/`)}>{t.common.businessInquiry}</a>
      </div>
    </div>
  </section>

  <section class="section-block site-shell home-about" aria-labelledby="home-about-title">
    <div class="home-about__lead" data-reveal>
      <p class="section-label">ABOUT HEV</p>
      <h2 id="home-about-title">{t.home.aboutTitle}</h2>
      <h3>{t.home.aboutLead}</h3>
      <p>{t.home.aboutBody}</p>
      <a class="text-link" href={withBase(`/${lang}/about/`)}>{t.nav.about}<span aria-hidden="true">↗</span></a>
    </div>
    <div class="pillar-list">
      {t.home.pillars.map((pillar, index) => (
        <article data-reveal>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p>{pillar.title}</p>
            <h3>{pillar.heading}</h3>
            <p>{pillar.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block projects-section" aria-labelledby="home-projects-title">
    <div class="site-shell section-heading" data-reveal>
      <div>
        <p class="section-label">PROJECTS</p>
        <h2 id="home-projects-title">{t.home.projectsTitle}</h2>
        <p>{t.home.projectsLead}</p>
      </div>
      <a class="text-link" href={withBase(`/${lang}/projects/`)}>{t.common.viewProjects}<span aria-hidden="true">↗</span></a>
    </div>
    <div class="site-shell project-list">
      {projects.map((entry, index) => <ProjectCard entry={entry} lang={lang} index={index} />)}
    </div>
  </section>

  <section class="section-block site-shell work-section" aria-labelledby="work-title">
    <div class="work-section__intro" data-reveal>
      <p class="section-label">WORK WITH HEV</p>
      <h2 id="work-title">{t.home.workTitle}</h2>
      <h3>{t.home.workLead}</h3>
      <p>{t.home.workBody}</p>
      <a class="button button--dark" href={withBase(`/${lang}/contact/`)}>{t.common.businessInquiry}</a>
    </div>
    <div class="work-grid">
      {t.home.workItems.map((item, index) => (
        <article data-reveal>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="highlights" aria-labelledby="highlights-title">
    <div class="site-shell">
      <p class="section-label" id="highlights-title">{t.home.highlightsTitle}</p>
      <div class="highlight-grid">
        {t.home.highlights.map((item) => (
          <article data-reveal>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-block site-shell" aria-labelledby="home-news-title">
    <div class="section-heading" data-reveal>
      <div>
        <p class="section-label">NEWS</p>
        <h2 id="home-news-title">{t.home.newsTitle}</h2>
      </div>
      <a class="text-link" href={withBase(`/${lang}/news/`)}>{t.common.viewNews}<span aria-hidden="true">↗</span></a>
    </div>
    <div class="news-grid">
      {news.map((entry) => <NewsCard entry={entry} lang={lang} />)}
    </div>
  </section>

  <BusinessCta lang={lang} />
</BaseLayout>
