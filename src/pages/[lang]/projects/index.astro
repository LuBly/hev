---
import BusinessCta from "../../../components/BusinessCta.astro";
import PageIntro from "../../../components/PageIntro.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import { languages, type Lang } from "../../../config/site";
import { getCopy } from "../../../i18n/copy";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getProjects } from "../../../lib/content";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getCopy(lang);
const projects = await getProjects(lang);
---

<BaseLayout lang={lang} title={`${t.nav.projects} | HEV`} description={t.projects.lead}>
  <PageIntro kicker="PROJECTS" title={t.projects.title} lead={t.projects.lead} />
  <div class="site-shell project-list project-list--page">
    {projects.map((entry, index) => <ProjectCard entry={entry} lang={lang} index={index} />)}
  </div>
  <BusinessCta lang={lang} />
</BaseLayout>
